# Copy to .env.local and fill in real values — never commit .env.local
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# service_role key is NEVER referenced in client code — only in server-side test/migration scripts
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_SERVER_ONLY
